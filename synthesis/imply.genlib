# Project-facing primitive library.
#
# IMPLY(a, b) = !a + b   (material implication, the only compute primitive)
# ZERO is the logic-level CONST0 source. In the emitted pulse sequence, each
# needed zero cell is created by a FALSE reset.
#
# ABC's mapper currently needs helper cells such as INV, so compile.py uses
# abc_imply.genlib as an adapter and then expands all helpers back to this
# ZERO + IMPLY primitive graph before sequencing.

GATE IMPLY  1  O=!a+b;     PIN * UNKNOWN 1 999 1 0 1 0
GATE ZERO   0  O=CONST0;
